# Copy to .env (which git ignores) and change the values before running anywhere but your own machine.
# Avoid "$" in these values: docker compose would treat it as a variable.

# SQL Server "sa" password: 8+ characters with upper case, lower case, digits and symbols.
DB_PASSWORD=Local_Only_Passw0rd!

# Signs the login tokens. 32+ random characters, e.g. from: openssl rand -base64 48
JWT_KEY=local-only-signing-key-replace-me-0123456789abcdef

# First admin account, created on first start.
ADMIN_EMAIL=admin@bookcenter.local
ADMIN_PASSWORD=Admin12345

# Port on your machine for the web app.
WEB_PORT=8080
